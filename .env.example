GEMINI_API_KEY=your_api_key_here

# Üretim modeli.
#
# Erişilebilirlik modeller arasında büyük fark gösteriyor. Aynı anahtar, aynı
# istek gövdesi ile ölçüldüğünde gemini-3.7-flash düz metin isteğinde bile
# 5 denemenin 3'ünde 503 "high demand" döndürdü; gemini-3.5-flash kararlıydı.
# Modeli değiştirdikten sonra dev sunucusunu yeniden başlatın.
GEMINI_MODEL=gemini-3.5-flash

# TEK ÜCRETLİ ÇAĞRI PRENSİBİ
#
# Hem şartname analizi (/api/analyze) hem katılımcı rapor analizi
# (/api/evaluate-report) bir kullanıcı işlemi için modele TAM OLARAK BİR
# ÜCRETLİ `generateContent` isteği gönderir. Yedek model kademesi, model tarama
# turu (sweep) ve devre kesici YOKTUR; bu yüzden GEMINI_FALLBACK_MODEL,
# GEMINI_THIRD_MODEL, GEMINI_MODEL_SWEEPS ve MODEL_COOLDOWN_MS değişkenleri
# kaldırıldı.
#
# 429 (hız sınırı/kota), zaman aşımı ve yapılandırma hataları yeniden
# DENENMEZ: uç açık bir hata döndürür, arayüz "Yeniden dene" düğmesini gösterir
# ve tekrar denemeye kullanıcı karar verir.
#
# TEK İSTİSNA — bedelsiz üst akış reddi. Gemini isteği bazen hiç okumadan
# 503 UNAVAILABLE ("high demand") ile geri çevirir; bu yanıtlarda usageMetadata
# yoktur, tek bir token bile faturalanmaz. Bu redi kullanıcıya "analiz
# başarısız" olarak geçirmek anlamsız olduğu için sunucu artan beklemeyle
# sınırlı sayıda yeniden dener. Ücretli çağrı sayısı yine 1'i aşmaz.
#
# Tanılama ve kullanım ölçümündeki `apiCalls` ÜCRETLİ istek sayısıdır
# (önbellek isabetinde 0), `rejectedAttempts` ise faturalanmayan red sayısıdır.

# Bedelsiz redde kurulacak en fazla HTTP isteği (ilk deneme dahil, üst sınır 6).
# 1 yazmak yeniden denemeyi tamamen kapatır ve eski davranışa döner.
GEMINI_MAX_ATTEMPTS=4

# Tüm denemeler için toplam süre bütçesi (ms, üst sınır 600000). Bütçede bir tam
# denemeye yer kalmadıysa yeni tur başlatılmaz; kullanıcı hemen hatayı görür.
GEMINI_TOTAL_BUDGET_MS=300000

# PDF sayfalarının modele verildiği görüntü çözünürlüğü: LOW | MEDIUM | HIGH.
#
# LOW olmalı. MEDIUM ile çok sayfalı şartnameler Gemini tarafında yüksek
# kapasiteli istek sayılıyor ve 503 "high demand" ile REDDEDİLİYOR. Ölçüm
# (29 sayfa · 1,8 MB, aynı istek): MEDIUM 4/4 kez 503 · LOW 3/3 kez başarılı.
# Kriter sayısı ve kaynak sayfa doluluğu değişmiyor; kural metinleri PDF'in
# metin katmanından okunuyor. Yalnızca görsel ayrıntı (şema/çizim) gerektiren
# belgelerde yükseltin — 503 riski geri gelir.
GEMINI_MEDIA_RESOLUTION=LOW

# Şartname analizinde modelin "düşünme" bütçesi; analiz süresinin en büyük
# belirleyicisidir. Boş bırakılırsa belge uzunluğuna göre seçilir:
#   < 40 sayfa → LOW · 40-79 sayfa → MEDIUM · 80+ sayfa → HIGH
# Daha fazla kriter derinliği için MEDIUM, daha hızlı yanıt için LOW yazın.
GEMINI_THINKING_LEVEL=

# Kimlik doğrulama katmanı bağlanana kadar analiz maliyetini koruyan geçici
# sunucu sınırları. Üretimde kullanıcı/kurum kotası ayrıca uygulanmalıdır.
ANALYSIS_RATE_LIMIT_WINDOW_MS=600000
ANALYSIS_RATE_LIMIT_MAX=20
ANALYSIS_GLOBAL_RATE_LIMIT_MAX=60
ANALYSIS_MAX_CONCURRENT=2

# Yerel kullanım sayaçlarını üretimde özellikle gerekmedikçe yayımlama.
ENABLE_USAGE_METRICS=off

# Yönetici oturum çerezini imzalayan anahtar. Üretimde uzun ve rastgele olmalı.
MODERATOR_SECRET=

# İlk Admin (00) hesabı için tek seferlik kurulum anahtarı.
MODERATOR_BOOTSTRAP_TOKEN=

# Şifresiz rol kısayolları yalnızca yerel geliştirmede kullanılmalıdır.
ALLOW_DEV_LOGIN=off
APP_ENV=development

# Opsiyonel gerçek e-posta gönderimi.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
APP_BASE_URL=
