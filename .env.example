GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Maliyet kontrolü: uzun belgelerde çalışan ikinci "eksik kural denetimi" turu
# kapsamı artırır ama token maliyetini ve süreyi yaklaşık iki katına çıkarır.
# off = tamamen kapat, on = açık (varsayılan)
COVERAGE_AUDIT=on
# Denetimin devreye gireceği en küçük sayfa sayısı (varsayılan 12)
COVERAGE_AUDIT_MIN_PAGES=12
