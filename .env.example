GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# TEK ÇAĞRI PRENSİBİ
#
# Hem şartname analizi (/api/analyze) hem katılımcı rapor analizi
# (/api/evaluate-report) bir kullanıcı işlemi için modele TAM OLARAK BİR
# `generateContent` isteği gönderir. Yedek model kademesi, model tarama turu
# (sweep), devre kesici ve arka planda çalışan yeniden deneme döngüsü YOKTUR;
# bu yüzden GEMINI_FALLBACK_MODEL, GEMINI_THIRD_MODEL, GEMINI_MODEL_SWEEPS,
# GEMINI_RETRY_BUDGET_MS ve MODEL_COOLDOWN_MS değişkenleri kaldırıldı.
#
# 429 (hız sınırı), 503 (model yoğun) veya zaman aşımında uç açık bir hata
# döndürür ve arayüz "Yeniden dene" düğmesini gösterir; tekrar denemeye
# kullanıcı karar verir. Tanılama ve kullanım ölçümündeki `apiCalls` gerçekten
# yapılan istek sayısıdır (önbellek isabetinde 0).

# PDF sayfalarının modele verildiği görüntü çözünürlüğü: LOW | MEDIUM | HIGH.
#
# LOW olmalı. MEDIUM ile çok sayfalı şartnameler Gemini tarafında yüksek
# kapasiteli istek sayılıyor ve 503 "high demand" ile REDDEDİLİYOR. Ölçüm
# (29 sayfa · 1,8 MB, aynı istek): MEDIUM 4/4 kez 503 · LOW 3/3 kez başarılı.
# Kriter sayısı ve kaynak sayfa doluluğu değişmiyor; kural metinleri PDF'in
# metin katmanından okunuyor. Yalnızca görsel ayrıntı (şema/çizim) gerektiren
# belgelerde yükseltin — 503 riski geri gelir.
GEMINI_MEDIA_RESOLUTION=LOW

# Şartname analizinde modelin "düşünme" bütçesi; analiz süresinin en büyük
# belirleyicisidir. Boş bırakılırsa belge uzunluğuna göre seçilir:
#   < 40 sayfa → LOW · 40-79 sayfa → MEDIUM · 80+ sayfa → HIGH
# Daha fazla kriter derinliği için MEDIUM, daha hızlı yanıt için LOW yazın.
GEMINI_THINKING_LEVEL=

# Kimlik doğrulama katmanı bağlanana kadar analiz maliyetini koruyan geçici
# sunucu sınırları. Üretimde kullanıcı/kurum kotası ayrıca uygulanmalıdır.
ANALYSIS_RATE_LIMIT_WINDOW_MS=600000
ANALYSIS_RATE_LIMIT_MAX=20
ANALYSIS_GLOBAL_RATE_LIMIT_MAX=60
ANALYSIS_MAX_CONCURRENT=2

# Yerel kullanım sayaçlarını üretimde özellikle gerekmedikçe yayımlama.
ENABLE_USAGE_METRICS=off

# Benzerlik motoru (GÖREV 3 · madde 5-6) — hepsi isteğe bağlıdır ve geçersiz
# değerler sessizce varsayılana döner (app/lib/similarity-config.ts).
#
# Katman 3 (LLM açıklama kontrolü) kapatma anahtarı: varsayılan AÇIK;
# "off" veya "0" yalnızca açıklama sınıflandırmasını kapatır, deterministik
# MinHash+embedding sonucu aynen üretilir.
SIMILARITY_LLM_ENABLED=
# Rapor seviye bantları (madde 6): %20 "hakem incelemesi önerilir",
# %40 "yüksek metin benzerliği". Test raporlarıyla kalibre edilebilir.
SIMILARITY_REPORT_REVIEW_PERCENT=
SIMILARITY_REPORT_HIGH_PERCENT=
# Parça eşik değerleri (0-1): doğrudan (MinHash) ve anlamsal (cosine).
SIMILARITY_DIRECT_HIGH=
SIMILARITY_DIRECT_REVIEW=
SIMILARITY_SEMANTIC_HIGH=
SIMILARITY_SEMANTIC_REVIEW=
# Katman 3'e giden en güçlü eşleşme sayısı (1-5, varsayılan 3).
SIMILARITY_LLM_TOP_K=
SIMILARITY_LLM_MIN_PERCENT=
# Çalışma zamanı sınırları (madde 8 · Worker CPU koruması): havuz üst sınırı
# (varsayılan 200 başvuru), istek başına süre bütçesi (varsayılan 15000 ms;
# dolunca koşu kalıcılaşır ve istemci sürdürür) ve parti boyutu (varsayılan 10).
SIMILARITY_POOL_MAX_APPS=
SIMILARITY_TIME_BUDGET_MS=
SIMILARITY_PEER_BATCH_APPS=
# Belge başına parça tavanı (varsayılan 400): patolojik uzunluktaki rapor
# binlerce parça üretip Worker belleğini dolduramaz; tavanı aşan kuyruk
# "tavan" gerekçesiyle denetim kaydına yazılır (asla sessiz kırpma yok).
SIMILARITY_MAX_CHUNKS=
# Gövde boyut kapıları (madde 9): benzerlik JSON tavanı (varsayılan 8388608 =
# 8 MB) ve ortak readJson tavanı (varsayılan 2097152 = 2 MB). Sınır, gerçek
# baytlar akışta sayılarak JSON ayrıştırmasından ÖNCE uygulanır.
SIMILARITY_MAX_BODY_BYTES=
REQUEST_JSON_MAX_BYTES=

# Yönetici oturum çerezini imzalayan anahtar. Üretimde uzun ve rastgele olmalı.
MODERATOR_SECRET=

# İlk Admin (00) hesabı için tek seferlik kurulum anahtarı.
MODERATOR_BOOTSTRAP_TOKEN=

# Şifresiz rol kısayolları KALDIRILDI (madde 7): giriş yalnızca kullanıcı adı
# veya e-posta + şifre ile yapılır ve rol veri tabanından okunur. Bu değişken
# artık hiçbir uç tarafından okunmaz; eski kurulumlarla uyum için bırakılmıştır.
ALLOW_DEV_LOGIN=off

# development: giriş ekranında "Kurulum Admini oluştur" (admin / 1234) düğmesi
# görünür ve tek seferlik bootstrap Admini açılabilir. production: bu uç 404 döner.
#
# GÜVENLİ VARSAYILAN (fail-closed): APP_ENV ve NODE_ENV hiç tanımlı değilse
# sistem PRODUCTION sayılır — dev bootstrap kapanır, çerezler Secure olur,
# hata ayrıntısı maskelenir. Geliştirme kolaylıkları yalnızca buraya açıkça
# development yazıldığında açılır.
APP_ENV=development

# Yerel "Kurulum Admini oluştur" (admin / 1234) ucunun AÇIK izni. Tek başına
# yetmez: APP_ENV=development + loopback istek + sıfır aktif Admin koşulları
# da birlikte aranır. ÜRETİMDE ASLA "on" YAPMAYIN.
ALLOW_LOCAL_ADMIN_BOOTSTRAP=on

# Opsiyonel gerçek e-posta gönderimi.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
APP_BASE_URL=
