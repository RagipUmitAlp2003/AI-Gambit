GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Şartname analizi TEK model çağrısıyla yapılır: PDF bir kez Files API'ye
# yüklenir, bütün belge tek geçişte okunur ve dört aşamalı kriter seti tek
# cevapta döner. Sayfa aralığı, paralel çağrı veya ikinci denetim turu yoktur;
# aşağıdaki yeniden deneme ayarları bu tek çağrının model kademeleri içindir.

# Birincil ve yedek model aynı anda 503 "high demand" döndürdüğünde devreye
# giren üçüncü kademe. Boş bırakılırsa zincir iki modelle çalışır.
GEMINI_THIRD_MODEL=

# Model listesinin baştan kaç kez taranacağı (1-4). Geçici 503/429 dalgası
# tek turda bütün kademeleri tüketirse ikinci tur belgeyi kurtarır.
GEMINI_MODEL_SWEEPS=2

# Yeniden denemeler için toplam duvar saati bütçesi (ms). Bütçe dolunca yeni
# model denemesi başlatılmaz, istek elde edilen son hatayla kapanır.
GEMINI_RETRY_BUDGET_MS=300000

# Bir model 5xx döndürdüğünde ne kadar süre devre dışı kalacağı (ms).
MODEL_COOLDOWN_MS=600000

# Kimlik doğrulama katmanı bağlanana kadar analiz maliyetini koruyan geçici
# sunucu sınırları. Üretimde kullanıcı/kurum kotası ayrıca uygulanmalıdır.
ANALYSIS_RATE_LIMIT_WINDOW_MS=600000
ANALYSIS_RATE_LIMIT_MAX=20
ANALYSIS_GLOBAL_RATE_LIMIT_MAX=60
ANALYSIS_MAX_CONCURRENT=2

# Yerel kullanım sayaçlarını üretimde özellikle gerekmedikçe yayımlama.
ENABLE_USAGE_METRICS=off

# Yönetici oturum çerezini imzalayan anahtar. Üretimde uzun ve rastgele olmalı.
MODERATOR_SECRET=

# İlk Admin (00) hesabı için tek seferlik kurulum anahtarı.
MODERATOR_BOOTSTRAP_TOKEN=

# Şifresiz rol kısayolları yalnızca yerel geliştirmede kullanılmalıdır.
ALLOW_DEV_LOGIN=off
APP_ENV=development

# Opsiyonel gerçek e-posta gönderimi.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
APP_BASE_URL=
