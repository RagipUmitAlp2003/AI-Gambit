# Analiz sağlayıcısı
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Moderatör paneli (Rol 00) — oturum imzalama anahtarı.
# ZORUNLU: tanımlı değilse tüm /api/admin/* uçları 503 ile reddedilir.
# En az 32 karakter rastgele değer üretin: openssl rand -base64 48
MODERATOR_SECRET=

# İlk 00 hesabını açmak için tek seferlik kurulum anahtarı.
# Yalnızca veri tabanında hiç hesap yokken çalışır; kurulum sonrası boşaltın.
MODERATOR_BOOTSTRAP_TOKEN=

# Mail sağlayıcı. Tanımlıysa bildirim Resend üzerinden gönderilir.
# Üretim ortamında tanımlı değilse bildirim "failed" olarak işaretlenir,
# sessizce giden kutusuna düşmez.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Mailde gösterilecek giriş adresi; boşsa istek adresi kullanılır.
APP_BASE_URL=

# "production" verildiğinde geliştirme kolaylıkları kapanır (mail outbox yedeği,
# güvensiz çerez). Cloudflare dağıtımında bu değeri production yapın.
APP_ENV=
